              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recommendations generated', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "const first = json && json.data && json.data.recommendations && json.data.recommendations[0];",
                  "if (first && first._id) {",
                  "  pm.collectionVariables.set('recommendationId', first._id);",
                  "}"
