            "body": {
              "mode": "raw",
              "raw": "{\n  \"snapshotDate\": \"{{$isoTimestamp}}\",\n  \"branchName\": \"Main Branch HQ\",\n  \"branchCode\": \"HQ-001\",\n  \"channel\": \"POS\",\n  \"sales\": {\n    \"orderCount\": 58,\n    \"itemCount\": 176,\n    \"grossRevenue\": 14250,\n    \"discounts\": 620,\n    \"tax\": 740,\n    \"refunds\": 90,\n    \"cogs\": 8600\n  },\n  \"inventory\": {\n    \"stockValue\": 51200\n  },\n  \"customers\": {\n    \"newCustomers\": 12,\n    \"returningCustomers\": 44,\n    \"loyaltyPointsIssued\": 1840\n  },\n  \"products\": [\n    {\n      \"sku\": \"SKU-COKE-1L\",\n      \"name\": \"Coca Cola 1L\",\n      \"category\": \"Beverages\",\n      \"quantitySold\": 52,\n      \"revenue\": 2600,\n      \"grossProfit\": 930,\n      \"currentStock\": 6,\n      \"reorderLevel\": 24,\n      \"daysOfSupply\": 2,\n      \"inventoryStatus\": \"LOW_STOCK\"\n    },\n    {\n      \"sku\": \"SKU-MILK-1L\",\n      \"name\": \"Fresh Milk 1L\",\n      \"category\": \"Dairy\",\n      \"quantitySold\": 34,\n      \"revenue\": 1700,\n      \"grossProfit\": 510,\n      \"currentStock\": 0,\n      \"reorderLevel\": 20,\n      \"daysOfSupply\": 0,\n      \"inventoryStatus\": \"OUT_OF_STOCK\"\n    },\n    {\n      \"sku\": \"SKU-RICE-5KG\",\n      \"name\": \"Premium Rice 5kg\",\n      \"category\": \"Grocery\",\n      \"quantitySold\": 18,\n      \"revenue\": 4500,\n      \"grossProfit\": 1350,\n      \"currentStock\": 42,\n      \"reorderLevel\": 15,\n      \"daysOfSupply\": 14,\n      \"inventoryStatus\": \"HEALTHY\"\n    }\n  ],\n  \"notes\": \"Sample snapshot for testing AI modules.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/business-analytics/snapshots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "business-analytics",
                "snapshots"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Snapshot created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data._id) {",
                  "  pm.collectionVariables.set('snapshotId', json.data._id);",
                  "}"
                ]
              }
            }
          ]
