          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/purchase-orders/suppliers?search=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "purchase-orders",
                "suppliers"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('At least one seeded active supplier exists', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const suppliers = pm.response.json()?.data || [];",
                  "  pm.expect(suppliers.length, 'Run `npm run seed` before this collection').to.be.above(0);",
                  "});",
                  "const supplier = pm.response.json()?.data?.[0];",
                  "if (supplier?._id) pm.collectionVariables.set('supplierId', supplier._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find Product For Supplier - Save ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/purchase-orders/catalog?supplierId={{supplierId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "purchase-orders",
                "catalog"
              ],
              "query": [
                {
                  "key": "supplierId",
                  "value": "{{supplierId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Seeded supplier has at least one linked product', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const products = pm.response.json()?.data || [];",
                  "  pm.expect(products.length, 'Seeded products must be linked to suppliers').to.be.above(0);",
                  "});",
                  "const product = pm.response.json()?.data?.[0];",
                  "if (product?.productId) {",
                  "  pm.collectionVariables.set('productId', product.productId);",
                  "  pm.collectionVariables.set('productSku', product.sku);",
                  "  pm.collectionVariables.set('productName', product.name);",
                  "}"
                ]
              }
            }
