{
  "info": {
    "name": "RetailSync - AI Modules Backend",
    "_postman_id": "35b588a7-4027-4c3d-bc4f-731d492a79cc",
    "description": "Postman collection for testing RetailSync AI Reordering and AI Assistant backend endpoints. Run Login first. Create the sample analytics snapshot before generating reorder recommendations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "loginEmail",
      "value": "admin@retailsync.com",
      "type": "string"
    },
    {
      "key": "loginPassword",
      "value": "Admin@123",
      "type": "string"
    },
    {
      "key": "snapshotId",
      "value": "",
      "type": "string"
    },
    {
      "key": "recommendationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Save JWT Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const token = json?.data?.token || json?.token;",
                  "if (!token) {",
                  "  pm.collectionVariables.unset('token');",
                  "  throw new Error('Login response did not include a token');",
                  "}",
                  "pm.collectionVariables.set('token', token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Seed Analytics Data",
      "item": [
        {
          "name": "Create Sample Analytics Snapshot",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"snapshotDate\": \"2026-07-09T00:00:00.000Z\",\n  \"branchName\": \"Main Branch HQ\",\n  \"branchCode\": \"HQ-001\",\n  \"channel\": \"POS\",\n  \"sales\": {\n    \"orderCount\": 58,\n    \"itemCount\": 176,\n    \"grossRevenue\": 14250,\n    \"discounts\": 620,\n    \"tax\": 740,\n    \"refunds\": 90,\n    \"cogs\": 8600\n  },\n  \"inventory\": {\n    \"stockValue\": 51200\n  },\n  \"customers\": {\n    \"newCustomers\": 12,\n    \"returningCustomers\": 44,\n    \"loyaltyPointsIssued\": 1840\n  },\n  \"products\": [\n    {\n      \"sku\": \"SKU-COKE-1L\",\n      \"name\": \"Coca Cola 1L\",\n      \"category\": \"Beverages\",\n      \"quantitySold\": 52,\n      \"revenue\": 2600,\n      \"grossProfit\": 930,\n      \"currentStock\": 6,\n      \"reorderLevel\": 24,\n      \"daysOfSupply\": 2,\n      \"inventoryStatus\": \"LOW_STOCK\"\n    },\n    {\n      \"sku\": \"SKU-MILK-1L\",\n      \"name\": \"Fresh Milk 1L\",\n      \"category\": \"Dairy\",\n      \"quantitySold\": 34,\n      \"revenue\": 1700,\n      \"grossProfit\": 510,\n      \"currentStock\": 0,\n      \"reorderLevel\": 20,\n      \"daysOfSupply\": 0,\n      \"inventoryStatus\": \"OUT_OF_STOCK\"\n    },\n    {\n      \"sku\": \"SKU-RICE-5KG\",\n      \"name\": \"Premium Rice 5kg\",\n      \"category\": \"Grocery\",\n      \"quantitySold\": 18,\n      \"revenue\": 4500,\n      \"grossProfit\": 1350,\n      \"currentStock\": 42,\n      \"reorderLevel\": 15,\n      \"daysOfSupply\": 14,\n      \"inventoryStatus\": \"HEALTHY\"\n    }\n  ],\n  \"notes\": \"Sample snapshot for testing AI modules.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/business-analytics/snapshots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "business-analytics",
                "snapshots"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Snapshot created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data._id) {",
                  "  pm.collectionVariables.set('snapshotId', json.data._id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
