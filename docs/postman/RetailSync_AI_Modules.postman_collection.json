            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"note\": \"Negative conversion regression test.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai-reordering/recommendations/{{unlinkedRecommendationId}}/convert-to-po",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai-reordering",
                "recommendations",
                "{{unlinkedRecommendationId}}",
                "convert-to-po"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unlinked recommendation returns a clean 400 validation response', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(false);",
                  "  pm.expect(json.code).to.eql('AI_REORDER_PRODUCT_REQUIRED');",
                  "  pm.expect(json.errors?.[0]?.field).to.eql('productId');",
                  "});",
                  "pm.test('Validation response exposes no stack trace or server path', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).not.to.have.property('stack');",
                  "  pm.expect(pm.response.text()).not.to.match(/(?:backend[\\/]|service\\.js:\\d+|node_modules[\\/])/i);",
                  "});"
                ]
              }
            }
          ]
        },
